    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
